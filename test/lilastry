import os
import time
import cv2
from google import genai
from google.genai import errors
from PIL import Image

# Needs GEMINI_API_KEY (or GOOGLE_API_KEY) set in your environment
client = genai.Client()

MODEL = "gemini-3.6-flash"   # or "gemini-flash-latest" to always get the newest Flash
INTERVAL_SECONDS = 3

PROMPT = (
    "Analyze the image and identify the single most important obstacle directly in front of the camera. "
    "Your response MUST consist ONLY of three values separated by the pipe symbol (|): OBJECT | POSITION | DANGER.\n"
    "- OBJECT: Name of the object (e.g., CHAIR, PERSON, WALL).\n"
    "- POSITION: Must be strictly one of: LEFT, CENTER, RIGHT.\n"
    "- DANGER: Must be strictly one of: YES, NO. (Output YES if it is an obstacle blocking the path).\n"
    "Do not include any intro, explanation, markdown formatting, or extra text.\n"
    "Example exactly like this: CHAIR | CENTER | YES"
)


def analyze(image):
    """Send one frame to Gemini; return (object, position, danger) or None."""
    for attempt in range(3):
        try:
            response = client.models.generate_content(model=MODEL, contents=[image, PROMPT])
            raw = (response.text or "").strip()
            parts = [p.strip() for p in raw.split("|")]
            if len(parts) != 3:
                print(f"⚠️ Unexpected format: {raw!r}")
                return None
            return tuple(parts)
        except errors.ServerError:
            print(f"Server busy, retrying... ({attempt + 1}/3)")
            time.sleep(2)
        except errors.ClientError as e:
            # 404 = bad model name, 400/403 = bad API key, 429 = rate limit
            print(f"❌ API error: {e}")
            return None
    return None


def main():
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("❌ Could not open webcam. Is another app using it?")
        return

    # Let auto-exposure settle; the first frames are often black
    for _ in range(10):
        cap.read()

    print(f"Running every {INTERVAL_SECONDS}s. Press Ctrl+C to stop.")
    try:
        while True:
            start = time.time()
            ret, frame = cap.read()
            if not ret:
                print("❌ Failed to grab frame.")
                break

            # OpenCV is BGR, PIL expects RGB. No file needed.
            image = Image.fromarray(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))

            result = analyze(image)
            if result:
                obj, pos, danger = result
                print(f"🎯 {obj} | {pos} | DANGER: {danger}")

            time.sleep(max(0, INTERVAL_SECONDS - (time.time() - start)))
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        cap.release()


if __name__ == "__main__":
    main()
